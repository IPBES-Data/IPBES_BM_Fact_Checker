---
config:
  layout: elk
  elk:
    nodePlacementStrategy: BRANDES_KOEPF
---
flowchart TD

  %% Conceptual workflow for the FACT-CHECKING project (_targets_factcheck.R).
  %% --
  %% One of three hand-authored workflow diagrams, one per targets project
  %% (see _targets.yaml and TD_targets.qmd):
  %% --
  %%   workflow_collection.mmd  collection: LOD -> refs -> zotero -> works ->
  %%                            snowball -> works_citing
  %%   workflow_factcheck.mmd   this file
  %%   workflow_reporting.mmd   everything that renders
  %% --
  %% Phase 1 has ONE backend on this branch: the Jev decisions API. The RunPod
  %% zero-shot pool and its fine-tune were retired on 2026-10-05 -- measured
  %% against refutations confirmed by three independent reviewers, they scored
  %% AUC 0.50 for REFUTES and 0.38 for SUPPORTS (chance and below) where Jev
  %% reached 0.737 [0.63, 0.84] on the same rows. The remnants live on the
  %% NLI_dirty branch; see design_notes.md points 3 and 5-8.

  %% Configuration. There is no global `active:` -- each project reads its own
  %% purpose block, so this one's selections come from `fact_checking:`.
  config_file@{ shape: doc, label: "Configuration <br><tt>input/config.yaml</tt>" }
  purpose_fc@{ shape: rect, label: "Purpose block<br/><tt>fact_checking:</tt><br/>assessments · nli · llm · claim_completion" }
  scorer_name@{ shape: rect, label: "Phase 1 scorer profile<br/><tt>fact_checking.nli</tt>" }
  llm_active@{ shape: rect, label: "LLM verification profile<br/><tt>fact_checking.llm</tt>" }

  config_file --> purpose_fc
  purpose_fc --> scorer_name
  purpose_fc --> llm_active

  %% Inputs produced by the collection project. Declared here as format = "file"
  %% targets keeping the producing project's names, so a genuine upstream change
  %% still invalidates this chain through content hashing.
  subgraph collected["From the collection project (workflow_collection.mmd)"]
    direction TB

    key_messages_db@{ shape: lin-cyl, label: "Key + Background Messages DB<br/><tt>output/collection/key_messages/assessment=&lt;id&gt;/</tt>" }
    refs_db@{ shape: lin-cyl, label: "References DB<br/><tt>output/collection/refs/assessment=&lt;id&gt;/</tt>" }
    works_db@{ shape: lin-cyl, label: "OpenAlex Works DB (seed / key papers)<br/><tt>output/collection/works/assessment=&lt;id&gt;/</tt>" }
    snowball_db@{ shape: lin-cyl, label: "Snowball DB (nodes / edges / keypaper)<br/><tt>output/collection/snowball/{nodes,edges,keypaper}/assessment=&lt;id&gt;/</tt>" }
    citing_db@{ shape: lin-cyl, label: "Citing Works DB (mapping + metadata)<br/><tt>output/collection/works_citing{,_meta}/assessment=&lt;id&gt;/</tt>" }
  end

  subgraph scope["Evidence scope (no LLM call for naive_bm/complete_bm)"]
    direction TB

    llm_scope@{ shape: rect, label: "Match citing works per claim via evidence sub-chapter refs<br/>{5.4.1} → refs sm → seed dois → snowball edges → citing works<br/>(naive_bm/atomic_bm only — complete_bm has no per-sub-claim tokens to match)<br/><tt>[llm_candidate_scope_parquet]</tt>" }
    llm_scope_db@{ shape: lin-cyl, label: "Candidate Scope DB<br/><tt>output/factchecker/llm_candidate_scope/assessment=&lt;id&gt;/km=&lt;km&gt;/bm=&lt;bm&gt;/</tt>" }

    llm_scope --> llm_scope_db
  end

  key_messages_db --> llm_scope
  refs_db --> llm_scope
  works_db --> llm_scope
  snowball_db --> llm_scope

  %% ══ PHASE 1 ══════════════════════════════════════════════════════════════
  %% Citing works and key papers run through ONE chain, split by a keypaper=
  %% hive partition rather than duplicated targets. keypaper= sits ABOVE
  %% assessment= deliberately: consolidate_claim_scores() globs with a
  %% $-anchored ".../assessment=/km=/bm=$" regex, which inserting a level
  %% between those three would break silently.
  subgraph phase1["Phase 1 — classify each work against each BM claim"]
    direction TB

    %% Nodes
    segment@{ shape: rect, label: "Segment each BM into claims — per granularity:<br/>naive_bm: evidence-delimited, one claim per sentence-group ending in a {ref} (+ a separate bm_label claim) — 2-17 claims per BM<br/>complete_bm: whole bm_description/bm_label as one claim each — 2 per BM (1 if identical)<br/>atomic_bm: split at EVERY evidence brace, then LLM-complete elliptical fragments into self-contained claims (confidence qualifiers extracted to their own column, same as naive_bm)<br/>then cross-join against each work's premise = clean(title + abstract)<br/><tt>[claim_work_pairs]</tt> · <tt>[claim_work_pairs_keypaper]</tt>" }
    pairs_db@{ shape: lin-cyl, label: "Claim × Work Pairs DB<br/><tt>output/factchecker/claim_work_pairs/granularity=&lt;gran&gt;/keypaper=&lt;t|f&gt;/assessment=&lt;id&gt;/km=&lt;km&gt;/bm=&lt;bm&gt;/</tt>" }
    jev_server@{ shape: cloud, label: "Jev decisions API<br/>typesafe/jev-1.13 · POST /api/alpha/decisions<br/>three typed questions per pair — supports / contradicts / bears-on<br/>cross-normalised to (p_supports, p_refutes, p_nei)<br/>~$0.00005/pair · no pod, no GPU<br/><tt>input/prompts/jev_claim_questions.json</tt>" }
    scoring@{ shape: rect, label: "Score each work against one BM claim<br/>premise = clean(title + abstract) · hypothesis = one BM claim<br/>→ SUPPORTS / REFUTES / NEI + full distribution<br/>one branch per claim; resumable at WORK granularity (delta dispatch)<br/><tt>[claim_units -> ..._flat -> claim_scores_by_claim]</tt><br/><tt>score_one_claim_jev()</tt>" }
    consolidate@{ shape: rect, label: "Merge per-claim scratch files into one parquet per (km, bm)<br/>and prune rows whose claim_id is gone<br/><tt>[claim_scores_consolidated]</tt> · <tt>[claim_scores_keypaper_consolidated]</tt>" }
    scores_db@{ shape: lin-cyl, label: "Claim Scores DB<br/><tt>output/factchecker/claim_scores/granularity=&lt;gran&gt;/scorer_config=&lt;cfg&gt;/keypaper=&lt;t|f&gt;/assessment=&lt;id&gt;/km=&lt;km&gt;/bm=&lt;bm&gt;/</tt>" }

    %% Edges
    segment --> pairs_db
    pairs_db --> scoring
    jev_server <--> scoring
    scoring --> consolidate
    consolidate --> scores_db
  end

  %% Inputs to Phase 1: BM text, segmented into claims first, then joined
  %% against citing works (keypaper=false) and seed papers (keypaper=true).
  key_messages_db --> segment
  citing_db --> pairs_db
  works_db --> segment
  snowball_db --> segment

  %% The selected scorer profile determines model config AND output partition.
  scorer_name --> scoring

  %% ══ RELEVANCE SCREEN ═════════════════════════════════════════════════════
  %% Sits between the phases. It asks one cheap question per routed pair --
  %% does this paper bear on the claim at all? -- because quote_is_verbatim()
  %% checks a quote EXISTS, never that it BEARS on the claim.
  subgraph screen["Relevance screen — scores, does NOT filter"]
    direction TB

    relevance@{ shape: rect, label: "One Jev question per routed pair<br/>typesafe/jev-1.13 · $0.0000172/pair<br/><tt>[relevance_screen]</tt> · <tt>[relevance_screen_keypaper]</tt>" }
    relevance_db@{ shape: lin-cyl, label: "Relevance DB<br/><tt>output/factchecker/llm_relevance/assessment=&lt;id&gt;/keypaper=&lt;t|f&gt;/</tt>" }
    relevance --> relevance_db
  end

  %% ⚠ THE FILTER IS OFF (relevance_screen.threshold is ~) and should stay off,
  %% for two separate reasons.
  %% --
  %% 1. A wrongly dropped pair leaves NO TRACE -- no verdict, no failed quote
  %%    check, nothing to audit. At a 0.3 cutoff only 76% of true SUPPORTS
  %%    survive and nobody has checked whether the rest are marginal or real.
  %% 2. ⚠ ITS SCORES ARE NOT PER-PAPER. It batches ~80 papers into one request
  %%    with the papers in `state` and the questions keyed by work_id -- but
  %%    question ids are never sent to the model, so it answers about the chunk.
  %%    Measured: 7,889 works under one claim share 23 distinct values. The fix
  %%    is the pattern score_one_claim_jev() now uses (item inside the question,
  %%    only shared context in state); until then these are chunk-level scores.
  %%    See design_notes.md point 6, Finding B.

  subgraph llm_verification["Phase 2 — LLM verification"]
    direction TB

    %% Nodes
    llm_server@{ shape: cloud, label: "OpenRouter LLM<br/>(gpt-4o-mini / gemini-2.5-flash / gpt-5)" }
    llm_verify@{ shape: rect, label: "Route scored pairs (citing works: label = REFUTES or SUPPORTS, certain only; key papers: EVERY pair, no routing)<br/>tag each with direct_evidence_match from the candidate scope above<br/>then call the LLM per (claim, work) — every routed pair reviewed, none filtered — Phase 1 label + confidence as prior<br/>→ SUPPORTS / REFUTES / NEI + verbatim quote, demoted to NEI if the quote is not actually in the premise<br/><tt>[llm_verification_parquet]</tt> · <tt>[llm_verification_keypaper_parquet]</tt>" }
    llm_scores_db@{ shape: lin-cyl, label: "LLM Verification Scores DB<br/><tt>output/factchecker/llm_verification/scores/llm_config=&lt;cfg&gt;/keypaper=&lt;t|f&gt;/assessment=&lt;id&gt;/nli_route=&lt;route&gt;/km=&lt;km&gt;/bm=&lt;bm&gt;/</tt>" }

    %% Edges
    llm_server <--> llm_verify
    llm_verify --> llm_scores_db
  end

  scores_db --> relevance
  jev_server <--> relevance
  relevance_db -.->|"scored, not applied"| llm_verify

  %% Inputs to Phase 2: Phase 1's own flagged output, plus the candidate-scope
  %% match set (used to TAG, never to filter).
  scores_db --> llm_verify
  llm_scope_db --> llm_verify
  llm_active --> llm_verify

  %% ══ KEY-PAPER QA ═════════════════════════════════════════════════════════
  %% Not a separate chain any more -- keypaper=true is a partition level inside
  %% both phases above. It asks the inverse question to the citing-works rows:
  %% do the papers IPBES ITSELF cites as evidence for a BM actually support it?
  %% A key paper IS that evidence, so it should land overwhelmingly in
  %% SUPPORTS -- when it does not, that is the signal worth chasing. Measured
  %% 2026-10-05: 77.8% of key papers confirmed against 18.9% of citing works,
  %% on the same claims.
  %% --
  %% keypaper = every paper tagged relation == "keypaper"; citing = citing AND
  %% NOT keypaper, so the two sets are disjoint by definition and need no
  %% de-duplication. 70% of GA1's key papers do cite another key paper, but
  %% pro_snowball() gives each node one relation tag with keypaper winning.

  %% ══ GOLD STANDARD ════════════════════════════════════════════════════════
  %% Human labels. It used to gate fine-tuning and the benchmark, and is kept
  %% because it is now the only thing that can test the decision that removed
  %% them -- every other comparison in this project is models judging models.
  gold_dir@{ shape: doc, label: "Blinded reviewer instruments + filled reviews<br/><tt>input/goldstandard/R{1,2}_&lt;id&gt;.csv</tt>" }
  gold@{ shape: rect, label: "Adjudicate R1 vs R2 → gold_&lt;id&gt;.csv<br/>agreement becomes gold; disagreement is the human ceiling (Cohen's kappa)<br/><tt>[goldstandard_dir -> goldstandard]</tt>" }
  gold_dir --> gold

  %% Where this arm's output goes.
  consumers@{ shape: doc, label: "Consumed by<br/><tt>workflow_reporting.mmd</tt> (funnels, QA)" }
  scores_db --> consumers
  llm_scores_db --> consumers
  gold --> consumers

  %% Styles
  classDef input_file  fill:#dbeafe,stroke:#2563eb,color:#1e3a8a,stroke-width:1.5px;
  classDef config      fill:#ecfccb,stroke:#65a30d,color:#14532d,stroke-width:1px;
  classDef database    fill:#fff3b0,stroke:#b45309,color:#111827,stroke-width:1.5px;
  classDef processing  fill:#bbf7d0,stroke:#16a34a,color:#14532d,stroke-width:1px;
  classDef helper      fill:#e0f2fe,stroke:#0284c7,color:#0f172a,stroke-width:1px;
  classDef handoff     fill:#f5f3ff,stroke:#7c3aed,color:#3b0764,stroke-width:1.5px,stroke-dasharray:4 3;

  class config_file input_file;
  class purpose_fc,scorer_name,llm_active config;
  class relevance_db,key_messages_db,refs_db,works_db,snowball_db,citing_db,llm_scope_db,pairs_db,scores_db,llm_scores_db database;
  class llm_scope,segment,scoring,consolidate,llm_verify,relevance processing;
  class jev_server,llm_server helper;
  class consumers handoff;
