flowchart TD


  %% External tools
  openalex@{ shape: cloud, label: "OpenAlex API" }
  zotero@{ shape: cloud, label: "Zotero" }
  sparsql@{ shape: cloud, label: "IPBES SPARSQL" }  

  %% Start
  config_file@{ shape: doc, label: "Configuration <br><tt>input/config.yaml</tt>" }
  assessment_list["Assessments to process"]
  config_file --> assessment_list


  assessment_id["Assessment &lt;id&gt;"]
  %% assessment2["Assessment &lt;id&gt;"]

  assessment_list --> assessment_id

  %% build refs
  build_refs["Query SPARQL refs<br/>KM → BM → SM → SubChapter ← Reference"]
  assessment_id --> build_refs
  sparsql <--> build_refs
  refs_db@{ shape: lin-cyl, label: "Refs DB<br/><tt>output/refs/</tt><br/><tt>  assessment=&lt;id&gt;/</tt>" }
  build_refs --> refs_db

  %% build sections
  build_sections["Query SPARQL sections<br/>KM → BM → SM → SubChapter → Chapter"]
  assessment_id --> build_sections
  sparsql <--> build_sections
  sections_db@{ shape: lin-cyl, label: "Sections DB<br/><tt>output/sections/</tt><br/><tt>  assessment=&lt;id&gt;/</tt>" }
  build_sections --> sections_db

  %% subgraph dbs[Databases]
  %% end
  %% Stage 2 — databases (hive-partitioned by assessment)

  %% Zotero
  download_zotero["Download all top-level Zotero group items<br/>page by page via Zotero API"]
  refs_db --> download_zotero
  zotero <--> download_zotero
  zotero_db@{ shape: lin-cyl, label: "Zotero DB<br/><tt>output/zotero/</tt><br/><tt>  assessment=&lt;id&gt;/</tt>" }
  download_zotero --> zotero_db

  %% OpenAlex / works
  download_works["Query OpenAlex works by DOI<br/>via openalexPro"]
  zotero_db --> download_works
  refs_db --> download_works
  openalex <--> download_works
  works_db@{ shape: lin-cyl, label: "Works DB<br/><tt>output/works/</tt><br/><tt>  assessment=&lt;id&gt;/</tt>" }
  download_works --> works_db

  %% Stage 3 — databases (hive-partitioned by assessment)

  %% Stage 4 — processing
  resolve_citations["Resolve inline (Author, Year) citations<br/>to OpenAlex W-IDs"]
  sections_db --> resolve_citations
  works_db --> resolve_citations
  zotero_db --> resolve_citations
  resolved_sections_db@{ shape: lin-cyl, label: "Resolved Sections DB<br/><tt>output/resolved_sections/</tt><br/><tt>  assessment=&lt;id&gt;/</tt>" }
  resolve_citations --> resolved_sections_db


  classDef input_file fill:#dbeafe,stroke:#2563eb,color:#1e3a8a,stroke-width:1.5px;
  classDef file fill:#fff3b0,stroke:#b45309,color:#111827,stroke-width:1.5px;
  classDef database fill:#fff3b0,stroke:#b45309,color:#111827,stroke-width:1.5px;
  classDef processing fill:#bbf7d0,stroke:#16a34a,color:#14532d,stroke-width:1px;
  classDef helper fill:#e0f2fe,stroke:#0284c7,color:#0f172a,stroke-width:1px;
  classDef config fill:#ecfccb,stroke:#65a30d,color:#14532d,stroke-width:1px;

  class config_file input_file;
  class config,assessment_list,assessment_id, config;
  class refs_db,sections_db,zotero_db,works_db,resolved_sections_db database;
  class build_refs,build_sections,download_zotero,download_works,resolve_citations processing;
  class openalex,zotero,sparsql helper;
