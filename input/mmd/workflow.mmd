---
config:
  layout: elk
  elk:
    nodePlacementStrategy: BRANDES_KOEPF
---
flowchart TD

  %% Configuration
  config_file@{ shape: doc, label: "Configuration <br><tt>input/config.yaml</tt>" }
  assessment_list@{ shape: rect, label: "Assessments to process" }
  assessment_id@{ shape: rect, label: "Assessment &lt;id&gt;" }

  config_file --> assessment_list
  assessment_list --> assessment_id
  assessment_id --> build_refs

  %% LOD Extraction — grouped so the three parallel queries stay in one horizontal band
  subgraph lod["IPBES LOD Extraction"]
    direction TB

    %% Nodes
    sparql@{ shape: cloud, label: "IPBES SPARQL endpoint" }
    build_refs@{ shape: rect, label: "Extract references<br/>KM → BM → SM → SubChapter ← Reference" }
    build_sections@{ shape: rect, label: "Extract section content<br/>KM → BM → SM → SubChapter → Chapter" }
    build_key_messages@{ shape: rect, label: "Extract Key/Background Messages<br/>KM → BM (with descriptions)" }

    %% Edges
    sparql <--> build_refs
    sparql <--> build_sections
    sparql <--> build_key_messages
  end

  assessment_id --> build_sections
  assessment_id --> build_key_messages

  subgraph data["Retrieve and prepare data"]
    direction TD

    %% Nodes
    refs_db@{ shape: lin-cyl, label: "References DB<br/><tt>output/refs/assessment=&lt;id&gt;/</tt>" }
    sections_db@{ shape: lin-cyl, label: "Sections DB<br/><tt>output/sections/assessment=&lt;id&gt;/</tt>" }
    key_messages_db@{ shape: lin-cyl, label: "Key + Background Messages DB<br/><tt>output/key_messages/assessment=&lt;id&gt;/</tt>" }
    zotero_api@{ shape: cloud, label: "Zotero API" }
    zotero_db@{ shape: lin-cyl, label: "Zotero DB<br/><tt>output/zotero/assessment=&lt;id&gt;/</tt>" }
    openalex@{ shape: cloud, label: "OpenAlex API" }
    works_db@{ shape: lin-cyl, label: "OpenAlex Works DB<br/><tt>output/works/assessment=&lt;id&gt;/km=&lt;km&gt;/bm=&lt;bm&gt;/</tt>" }
    citing_db@{ shape: lin-cyl, label: "Citing Works DB<br/><tt>output/works_citing/assessment=&lt;id&gt;/km=&lt;km&gt;/bm=&lt;bm&gt;/</tt>" }
    prompts_truth_db@{ shape: lin-cyl, label: "Truth Prompts DB<br/><tt>output/prompts/truth/assessment=&lt;id&gt;/</tt>" }
    prompts_citing_db@{ shape: lin-cyl, label: "Citing Prompts DB<br/><tt>output/prompts/citing/assessment=&lt;id&gt;/km=&lt;km&gt;/bm=&lt;bm&gt;/</tt>" }
    download_zotero@{ shape: rect, label: "Download Zotero group items<br/>page by page via Zotero API" }
    download_works@{ shape: rect, label: "Query OpenAlex works by DOI<br/>via openalexPro" }
    snowball@{ shape: rect, label: "Snowball search<br/>keypaper + citing" }

    prompts_truth@{ shape: rect, label: "Build truth prompts (JSON)<br/>one per KM/BM" }
    prompts_citing@{ shape: rect, label: "Build citing prompts (JSON)<br/>one per citing work" }


    %% Edges
    build_refs        --> refs_db
    build_sections    --> sections_db
    build_key_messages --> key_messages_db

    %% Download spine
    refs_db --> download_zotero
    zotero_api --> download_zotero
    download_zotero --> zotero_db

    zotero_db --> download_works
    openalex <--> download_works
    download_works --> works_db

    %% AI alignment scoring
    works_db --> snowball
    snowball --> citing_db

    key_messages_db --> prompts_truth
    %% works_db --> prompts_truth
    sections_db --> prompts_truth
    prompts_truth --> prompts_truth_db

    citing_db --> prompts_citing
    prompts_citing --> prompts_citing_db


  end

  subgraph ai_assessment["Assessment of the alignement of the KMs and the Citing Publications"]
    direction TB

    %% Nodes
    system_prompt@{ shape: doc, label: "System prompt<br/><tt>input/prompts/system_prompt.md</tt>" }
    truth_wrapper@{ shape: doc, label: "Truth prompt wrapper<br/><tt>input/prompts/truth_wrapper.md</tt>" }
    citing_wrapper@{ shape: doc, label: "Citing prompt wrapper<br/><tt>input/prompts/citing_wrapper.md</tt>" }
    openrouter@{ shape: cloud, label: "OpenRouter LLM API" }
    alignement_scoring@{ shape: rect, label: "Score citing prompts vs truth<br/>(shared prefix cache)" }
    scores_db@{ shape: lin-cyl, label: "Alignement Scores DB<br/><tt>output/alignement_scores/assessment=&lt;id&gt;/run_id=&lt;run_id&gt;/</tt>" }

    %% Edges
    system_prompt --> alignement_scoring
    truth_wrapper --> alignement_scoring
    citing_wrapper --> alignement_scoring
    openrouter <--> alignement_scoring
    alignement_scoring --> scores_db
  end

  %% Force `ai_assessment` to sit below `data` (subgraph-to-subgraph edge).
  %% Made invisible via linkStyle below so it doesn't add visual noise.
  data --> ai_assessment

  prompts_truth_db --> alignement_scoring
  prompts_citing_db --> alignement_scoring

  %% Resolution
  %% works_db    --> resolve_citations["Resolve inline (Author, Year) citations<br/>to OpenAlex W-IDs"]
  %% zotero_db   --> resolve_citations
  %% sections_db --> resolve_citations
  %% resolve_citations --> resolved_sections_db@{ shape: lin-cyl, label: "Resolved Sections DB<br/><tt>output/resolved_sections/assessment=&lt;id&gt;/</tt>" }

  %% Styles
  classDef input_file  fill:#dbeafe,stroke:#2563eb,color:#1e3a8a,stroke-width:1.5px;
  classDef config      fill:#ecfccb,stroke:#65a30d,color:#14532d,stroke-width:1px;
  classDef database    fill:#fff3b0,stroke:#b45309,color:#111827,stroke-width:1.5px;
  classDef processing  fill:#bbf7d0,stroke:#16a34a,color:#14532d,stroke-width:1px;
  classDef helper      fill:#e0f2fe,stroke:#0284c7,color:#0f172a,stroke-width:1px;
  classDef disabled    fill:#f1f5f9,stroke:#94a3b8,color:#64748b,stroke-width:1px,stroke-dasharray:4 3;

  %% Hide the data → ai_assessment subgraph-level constraint edge (index 29).
  %% If you add or remove edges above, bump this index.
  linkStyle 29 stroke:transparent,fill:none;

  class config_file input_file;
  class assessment_list,assessment_id config;
  class citing_db,refs_db,sections_db,key_messages_db,zotero_db,works_db,prompts_truth_db,prompts_citing_db,scores_db database;
  class build_refs,build_sections,build_key_messages,download_zotero,download_works,snowball,prompts_truth,prompts_citing,alignement_scoring processing;
  class sparql,zotero_api,openalex,openrouter helper;
  class system_prompt,truth_wrapper,citing_wrapper input_file;
