---
config:
  layout: elk
  elk:
    nodePlacementStrategy: BRANDES_KOEPF
---
flowchart TD

  %% Reporting project (_targets_reporting.R). Every qa_*/report_* node lives
  %% here, because those targets do. The databases they read are drawn as
  %% EXTERNAL inputs -- they are produced by the other projects and reach this
  %% one as format = "file" declarations keeping the producing project's names.
  %% --
  %% The training-data and fine-tuned-model QA reports were removed on
  %% 2026-10-05 with the training project itself (design_notes.md points 3, 7).
  %% The key-paper views stay: that chain moved into factcheck, not away, and
  %% is now a keypaper= partition level rather than a parallel set of trees --
  %% which is why there is one scores DB node here where there used to be two.
  %% --
  %% Several target names here still read nli_* (nli_overview_data,
  %% nli_scores_qa_data, nli_bm_explorer_html, nli_granularities). That is the
  %% live naming: the 2026-10-07 rename to claim_*/scorer_* covered
  %% _targets_factcheck.R only. Phase 1 itself is Jev, not an NLI model.

  subgraph upstream["Inputs (produced by the other projects)"]
    direction TB
  pairs_db@{ shape: lin-cyl, label: "Claim × Work Pairs DB<br/><tt>output/factchecker/claim_work_pairs/granularity=&lt;gran&gt;/keypaper=&lt;t|f&gt;/assessment=&lt;id&gt;/km=&lt;km&gt;/bm=&lt;bm&gt;/</tt>" }
  scores_db@{ shape: lin-cyl, label: "Claim Scores DB (citing works + key papers)<br/><tt>output/factchecker/claim_scores/granularity=&lt;gran&gt;/scorer_config=&lt;cfg&gt;/keypaper=&lt;t|f&gt;/assessment=&lt;id&gt;/km=&lt;km&gt;/bm=&lt;bm&gt;/</tt>" }
  llm_scores_db@{ shape: lin-cyl, label: "LLM Verification Scores DB (citing works + key papers)<br/><tt>output/factchecker/llm_verification/scores/llm_config=&lt;cfg&gt;/keypaper=&lt;t|f&gt;/assessment=&lt;id&gt;/nli_route=&lt;route&gt;/km=&lt;km&gt;/bm=&lt;bm&gt;/</tt>" }
  citing_db@{ shape: lin-cyl, label: "Citing Works DB<br/><tt>output/collection/works_citing{,_meta}/assessment=&lt;id&gt;/</tt>" }
  works_db@{ shape: lin-cyl, label: "OpenAlex Works DB<br/><tt>output/collection/works/assessment=&lt;id&gt;/km=&lt;km&gt;/bm=&lt;bm&gt;/</tt>" }
  end

    qa_bm_split@{ shape: doc, label: "QA report: how each BM was segmented into claims<br/><tt>[bm_split_report_highlighted]</tt>" }
    qa_scores@{ shape: doc, label: "QA report: Phase 1 score distribution + key-paper overlay<br/><tt>[nli_scores_qa_data -> nli_scores_qa_figures]</tt>" }
    qa_llm_verify@{ shape: doc, label: "QA report: Phase 2 verdicts vs Phase 1 labels<br/><tt>[llm_verification_qa_data -> llm_verification_qa_figures]</tt>" }

  subgraph general_reports["General & additional reports (no new computation)"]
    direction TB

    %% Nodes -- these are read-only reporting/browsing views over data
    %% already produced above; none of them triggers new scoring/LLM calls.
    report_overview@{ shape: doc, label: "Label/confidence/alignment overview + interactive BM explorer<br/><tt>[nli_overview_data -> nli_overview_figures, nli_bm_explorer_html]</tt>" }
    report_overlap@{ shape: doc, label: "Overlap tables: key papers cited by >1 BM; post-2018 citing works cited by >5 BMs<br/><tt>[overlap_key_paper_table, overlap_after_2018_sub_messages_table, overlap_after_2018_background_messages_table]</tt>" }
    report_pub_year@{ shape: doc, label: "New publications per year, by background message<br/><tt>[fig_pub_per_year]</tt>" }
    report_funnel@{ shape: doc, label: "REFUTES/SUPPORTS label funnel: corpus -&gt; Phase 1-flagged -&gt; LLM-confirmed<br/><tt>[refutes_funnel_data/figures/tables, supports_funnel_data/figures/tables]</tt>" }
  end

  pairs_db --> qa_bm_split
  scores_db --> qa_scores
  llm_scores_db --> qa_llm_verify
  scores_db --> report_overview
  citing_db --> report_overview
  works_db --> report_overlap
  citing_db --> report_overlap
  citing_db --> report_pub_year
  scores_db --> report_funnel
  llm_scores_db --> report_funnel

  classDef database  fill:#fff3b0,stroke:#b45309,color:#111827,stroke-width:1.5px;
  classDef qa_report fill:#ede9fe,stroke:#7c3aed,color:#3b0764,stroke-width:1.5px;
  class pairs_db,scores_db,llm_scores_db,citing_db,works_db database;
  class qa_bm_split,qa_llm_verify,qa_scores,report_funnel,report_overlap,report_overview,report_pub_year qa_report;
