# Config for external/runpod's scripts/runpod/create_pods.sh — the zero-shot
# NLI pod (external/runpod/docker/nli-runpod/). Tracked in this repo (unlike
# the unified runpod repo's own scripts/runpod/config/pods.conf, which is
# gitignored there) so this project's actual launch recipe stays versioned;
# pass it explicitly via -c so create_pods.sh doesn't fall back to its own
# gitignored default path. Values here are shell variable assignments
# (sourced directly), not YAML.
#
# Usage:
#   export RUNPOD_API_KEY=...
#   external/runpod/scripts/runpod/create_pods.sh -n 7 -c input/nli_pods.conf
#
# `-n 7` MUST be passed explicitly on every call — this file has no pod-count
# variable of its own (create_pods.sh takes it as a CLI flag, not a sourced
# config value), and the script defaults to -n 1 if it's omitted. A single
# pod would silently mismatch input/config.yaml's 7-host
# nli.configs.deberta_zeroshot.host list and the crew_controller_local
# worker count _targets.R derives from it.
#
# RUNPOD_API_KEY is NOT set here — export it in your shell before running the
# script. It authenticates the pod-creation API call itself (this always needs
# the raw key — RunPod Secrets are substituted inside a running pod, not in
# requests to create one).

# Rebuilt from the unified runpod repo as v0.1.0 (was v0.2.3) — this also
# picks up the idle-watchdog fix (previously called `runpodctl stop pod`
# directly, which silently failed, so idle pods never actually auto-stopped).
# Bump the tag again after any further rebuild/push.
IMAGE="ghcr.io/rkrug/nli-runpod:v0.1.0"

# GPU type id exactly as RunPod expects it. Alternatives seen in this
# project's own configs: "NVIDIA A100 80GB PCIe", "NVIDIA L40S",
# "NVIDIA RTX A6000", "NVIDIA A40". List current availability with:
#   curl -s https://rest.runpod.io/v1/gpuTypes \
#     -H "Authorization: Bearer $RUNPOD_API_KEY" | jq -r '.[].id'
GPU_TYPE_ID="NVIDIA L4"
GPU_COUNT=1

# HTTP service exposed through RunPod's proxy at
# https://<pod-id>-8080.proxy.runpod.net (matches NLI_PORT in the Dockerfile).
POD_KIND="http"
PORT=8080
HEALTH_PATH="/health"

# Disk sizing (GB). The model is baked into the image, so volume storage is
# mostly headroom, not required for correctness.
CONTAINER_DISK_GB=10
VOLUME_GB=0
VOLUME_MOUNT_PATH="/workspace"

# RunPod cloud tier: SECURE (RunPod-operated DCs) or COMMUNITY (cheaper, less
# guaranteed availability).
CLOUD_TYPE="SECURE"

# Name prefix; with -n 7 pods are named "nli-runpod-<timestamp>-01" .. "-07".
POD_NAME_PREFIX="nli-runpod"

# Idle watchdog settings, passed into each pod's environment.
IDLE_MIN=5
POLL_SEC=30

# Value for each created pod's own RUNPOD_API_KEY env var. This is the exact
# RunPod Secret reference already in use — note the name doesn't actually
# describe an NLI pod ("TEI-RUNPOD-API" is a leftover/misnomer from another
# context); kept as-is here since it's what the real Secret is named today.
# Rename the Secret itself (and this line) if you'd rather it read
# `runpod_api_key`, matching the other images' convention.
POD_ENV_RUNPOD_API_KEY='{{ RUNPOD_SECRET_TEI-RUNPOD-API }}'

# How long (seconds) to poll each new pod's /health before giving up.
HEALTH_TIMEOUT_SEC=300
HEALTH_POLL_INTERVAL_SEC=10

# Delay (seconds) between successive pod-creation calls. Matters here more
# than for the other repos' single-pod configs — this staggers 7 simultaneous
# image pulls instead of all landing on the registry/network at once.
CREATE_DELAY_SEC=10
